// Copy this file to config.h and fill in real values -- config.h itself is
// gitignored (see .gitignore), the same "personal, real, never committed"
// treatment meterkast-dns's own .env/device-playlist.toml get.
#pragma once

// Optional one-time seed, not a requirement -- used only on the very
// first boot, before anything's ever been saved via the captive portal.
// Leave both undefined (comment out) entirely and the device will boot
// straight into an open "DEVICE_HOSTNAME"-named setup AP; connect to it
// and open http://192.168.4.1/ to provision WiFi from any phone/laptop,
// no reflash required. Once provisioned, credentials live in NVS
// (Preferences), not here -- POST /wifi/reset (see README) clears them
// and reboots back into the portal if you ever need to reconfigure.
// #define WIFI_SSID "your-wifi-ssid"
// #define WIFI_PASSWORD "your-wifi-password"

// Also the mDNS hostname this device advertises itself as
// (http://meterkast-proxy.local/ once connected) -- separate from
// meterkast-dns's own hostname on purpose, this is a different device.
// #ifndef-guarded so a per-board platformio.ini env can override it via
// build_flags (see esp32-c6-devkitc-1's -DDEVICE_HOSTNAME, needed so it
// doesn't collide on the LAN/mDNS with another board using this same
// config.h -- e.g. m5stick-c) without needing a second config.h.
#ifndef DEVICE_HOSTNAME
#define DEVICE_HOSTNAME "meterkast-proxy"
#endif

// mDNS has no wildcard "browse everything" query the way BLE scanning can
// passively see any advertiser -- each service type has to be asked for
// by name. Add whatever's relevant on your LAN; unknown/absent services
// just return nothing, not an error. Each entry is its own {type, proto}
// pair (not one shared proto for all of them) since not everything is
// _tcp -- Matter's commissionable-node service is _udp, for one.
// _matter._tcp is operational (already-commissioned) Matter nodes;
// _matterc._udp is commissionable nodes actively looking to be paired,
// arguably the more useful one for discovery.
#define MDNS_SERVICE_TYPES { \
  {"_home-assistant", "_tcp"}, {"_googlecast", "_tcp"}, {"_hap", "_tcp"}, {"_http", "_tcp"}, \
  {"_matter", "_tcp"}, {"_matterc", "_udp"} \
}

// How often the mDNS browser re-queries every configured service type.
// BLE scanning is continuous/passive in the background and needs no
// equivalent interval.
#define MDNS_QUERY_INTERVAL_MS 30000

// No device-specific BLE config lives here anymore -- GATT reads
// (POST /gatt/session) and raw advertisement service-data capture
// (the serviceData field on GET /scan/ble) are both fully generic and
// driven entirely by the request/whatever's broadcasting, never
// compiled in. Which real device a MAC address belongs to, which
// characteristics/service-data mean what, and how to decode them are
// meterkast-dns's own playlist's job now, not firmware's -- see
// gatt_session.h and README.md.
