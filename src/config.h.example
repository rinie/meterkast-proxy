// Copy this file to config.h and fill in real values -- config.h itself is
// gitignored (see .gitignore), the same "personal, real, never committed"
// treatment meterkast-dns's own .env/device-playlist.toml get.
#pragma once

// Optional one-time seed, not a requirement -- used only on the very
// first boot, before anything's ever been saved via the captive portal.
// Leave both undefined (comment out) entirely and the device will boot
// straight into an open "DEVICE_HOSTNAME"-named setup AP; connect to it
// and open http://192.168.4.1/ to provision WiFi from any phone/laptop,
// no reflash required. Once provisioned, credentials live in NVS
// (Preferences), not here -- POST /wifi/reset (see README) clears them
// and reboots back into the portal if you ever need to reconfigure.
// #define WIFI_SSID "your-wifi-ssid"
// #define WIFI_PASSWORD "your-wifi-password"

// Also the mDNS hostname this device advertises itself as
// (http://meterkast-proxy.local/ once connected) -- separate from
// meterkast-dns's own hostname on purpose, this is a different device.
// #ifndef-guarded so a per-board platformio.ini env can override it via
// build_flags (see esp32-c6-devkitc-1's -DDEVICE_HOSTNAME, needed so it
// doesn't collide on the LAN/mDNS with another board using this same
// config.h -- e.g. m5stick-c) without needing a second config.h.
#ifndef DEVICE_HOSTNAME
#define DEVICE_HOSTNAME "meterkast-proxy"
#endif

// mDNS has no wildcard "browse everything" query the way BLE scanning can
// passively see any advertiser -- each service type has to be asked for
// by name. Add whatever's relevant on your LAN; unknown/absent services
// just return nothing, not an error.
#define MDNS_SERVICE_TYPES { "_home-assistant", "_googlecast", "_hap", "_http" }
#define MDNS_SERVICE_PROTO "_tcp"

// How often the mDNS browser re-queries every configured service type.
// BLE scanning is continuous/passive in the background and needs no
// equivalent interval.
#define MDNS_QUERY_INTERVAL_MS 30000

// Optional one-time seed for the scale's BLE MAC (a single GATT device --
// a weight scale -- actively connected to and read on an interval,
// buffering the last good result). Like WIFI_SSID/PASSWORD above, this
// isn't required: leave it undefined and configure the MAC at runtime
// instead -- GET /scale/discover while stepping on the scale finds it
// (filters the passive BLE scan by MAC prefix, defaults to the Medisana
// E4:54:EB range below), then POST /scale/config {"mac":"E4:54:EB:.."}
// sets it, no reflash required (see README).
// #define SCALE_MAC_ADDRESS "E4:54:EB:XX:XX:XX"

// Defaults target a Medisana BS440-family scale (BS410/BS430/BS440/
// BS444 -- same protocol across all of them) if left undefined. This
// device has no standard Bluetooth SIG weight-scale profile at all --
// every UUID/command below is reverse-engineered (openScale wiki,
// keptenkurk/BS440, ha-medisana-scale, cross-referenced, not an
// official spec). Override every one of these for a different scale
// entirely -- see scale_reader.cpp for the full protocol writeup.
// #define SCALE_SERVICE_UUID "000078b2-0000-1000-8000-00805f9b34fb"
// #define SCALE_WEIGHT_CHARACTERISTIC_UUID "00008a21-0000-1000-8000-00805f9b34fb"
// #define SCALE_FEATURE_CHARACTERISTIC_UUID "00008a22-0000-1000-8000-00805f9b34fb"
// #define SCALE_CUSTOM5_CHARACTERISTIC_UUID "00008a82-0000-1000-8000-00805f9b34fb"
// #define SCALE_CMD_CHARACTERISTIC_UUID "00008a81-0000-1000-8000-00805f9b34fb"
// #define SCALE_TRIGGER_COMMAND { 0x02, 0x7b, 0x7b, 0xf6, 0x0d }

// How often to run a real connect/subscribe/trigger/read cycle against
// the scale. Defaults to 30000 if left undefined.
// #define SCALE_READ_INTERVAL_MS 30000

// How long to wait for the weight indication to arrive after writing
// the trigger command before giving up on that cycle (this device's
// measurement is asynchronous, not a direct reply). Defaults to 8000
// if left undefined.
// #define SCALE_INDICATION_TIMEOUT_MS 8000
